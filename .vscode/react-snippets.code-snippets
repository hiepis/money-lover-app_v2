  "Expense Item Component": {
    "prefix": "expense-component",
    "body": [
      "import React from 'react';",
      "",
      "interface ExpenseItemProps {",
      "  id: string;",
      "  amount: number;",
      "  description: string;",
      "  category: string;",
      "  date: string;",
      "  onEdit?: (id: string) => void;",
      "  onDelete?: (id: string) => void;",
      "}",
      "",
      "const ExpenseItem: React.FC<ExpenseItemProps> = ({",
      "  id,",
      "  amount,",
      "  description,",
      "  category,",
      "  date,",
      "  onEdit,",
      "  onDelete",
      "}) => {",
      "  return (",
      "    <div className=\"expense-item p-4 border rounded-lg bg-white shadow-sm\">",
      "      <div className=\"flex justify-between items-center\">",
      "        <div>",
      "          <h3 className=\"font-semibold\">{description}</h3>",
      "          <p className=\"text-sm text-gray-600\">{category} • {date}</p>",
      "        </div>",
      "        <div className=\"flex items-center gap-2\">",
      "          <span className=\"font-bold text-lg\">${amount.toFixed(2)}</span>",
      "          {onEdit && (",
      "            <button",
      "              onClick={() => onEdit(id)}",
      "              className=\"text-blue-600 hover:text-blue-800\"",
      "            >",
      "              Edit",
      "            </button>",
      "          )}",
      "          {onDelete && (",
      "            <button",
      "              onClick={() => onDelete(id)}",
      "              className=\"text-red-600 hover:text-red-800\"",
      "            >",
      "              Delete",
      "            </button>",
      "          )}",
      "        </div>",
      "      </div>",
      "    </div>",
      "  );",
      "};",
      "",
      "export default ExpenseItem;"
    ],
    "description": "Create an expense item component for the expense tracker"
  }
}